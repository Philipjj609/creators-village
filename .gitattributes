* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.png binary
*.webp binary
*.glb binary

# Hash-pinned source and runtime exports must retain their exact bytes.
assets/generated/** -text whitespace=cr-at-eol
assets/source/** -text whitespace=cr-at-eol
