# Secret-free template. Store real values only in the hosting secret manager or ignored local files.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
# Set to 1 only after confirming a single trusted ingress; application port must not be directly public.
TRUST_PROXY_HOPS=
WEB_ORIGIN=https://YOUR-ASSIGNED-HOST.onrender.com
TWITCH_REDIRECT_URI=https://YOUR-ASSIGNED-HOST.onrender.com/auth/twitch/callback
AUTH_MODE=twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Separate identities. Never log either URL or put them in VITE_* variables.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# tls verifies hostname and certificate. Optional DATABASE_CA_FILE for a custom CA.
# private-network is permitted ONLY on a verified provider-private network (or isolated local Docker network).
# Never use private-network for an internet database connection, e.g. Neon.
DATABASE_TRANSPORT=tls
GAMEPLAY_WRITES=paused
# Explicit approved private cohort world only; never a copied private world without data-transfer approval.
WF2_APPROVED_WORLD_ID=
