  "materials": {
    "mapping": "Global, world-anchored: in the terrain container's local (projected) coordinates, uv = (sx / 512, sy / 256) for every ground tile, where (sx, sy) is the drawn vertex position (z already applied). Tiles are one world period (8 x 8 units) of a world-periodic pattern, so they repeat on screen every 512 x 256 px at Pixi scale 1. No camera term, so no swimming; the same mapping on every chunk and LOD block, so no seams. Height shifts the pattern by z*32*sqrt(1.5) px, which is static and continuous.",
    "sampler": {
      "addressMode": "repeat",
      "scaleMode": "linear",
      "autoGenerateMipmaps": true,
      "note": "power-of-two tiles; mipmaps prevent overview shimmer (Pixi otherwise minifies without them)"
    },
    "rules": [
      {
        "material": "water",
        "file": "water.png",
        "when": "flags != 255 && (flags & 1)",
        "z": "fixed water plane 0.5"
      },
      {
        "material": "woodland",
        "file": "woodland.png",
        "when": "flags != 255 && !(flags & 1) && (flags & (8 | 2))"
      },
      {
        "material": "grass",
        "file": "grass.png",
        "when": "flags != 255 && !(flags & 1) (everything else, including ROCK cells)"
      },
      {
        "material": "bank",
        "file": "bank.png",
        "when": "the existing coastEdges() bank faces"
      },
      {
        "material": "none",
        "when": "flags == 255 (missing): draw nothing, exactly as today"
      }
    ],
    "tint": "Keep terrainMaterial()'s deterministic shade s = clamp(round(slope*9) + variation, -8, 9) but apply it as a multiplicative grey tint: rgb = 236 + 2*s per channel (range 220..254). Water: 0xF2FFFC when waterNeighbors < 4, else 0xFFFFFF.",
    "classification": "Unchanged. The material is chosen from the persisted flags; nothing here alters flags, heights, the triangle split, walkability or LOD subdivision."
  },
  "edges": {
    "path": {
      "geometry": "Authoritative centreline points and width w = widthQ/256 (founding path: width 1.5). Segments are axis-aligned. Subdivide each segment into pieces no longer than 1 unit and project every vertex with terrainReader.height (as the current stroke does).",
      "core": {
        "file": "path-dirt.png",
        "mapping": "global (same as materials)",
        "shape": "per segment: rectangle of width w - 0.30 along the segment; per vertex: square of side w - 0.30 centred on it (covers joins, T-junctions and crossings)"
      },
      "fringe": {
        "file": "path-fringe.png",
        "shape": "per segment and side: quad from w/2 - 0.15 to w/2 + 0.42 off the centreline, outward",
        "u": "distance along the segment from its first point / 4 (repeat)",
        "v": "0 at the inner edge, 1 at the outer edge"
      },
      "joint": {
        "file": "path-joint.png",
        "shape": "per vertex (corners, junctions and both ends): square of side 2.34 * (w / 1.5) centred on the vertex",
        "uv": "0..1 across the square"
      },
      "drawOrder": "joints, then fringes, then cores (cores opaque on top), all in the terrain layer below groundBand",
      "result": "The 50% alpha line of the soft edge sits on the authoritative edge (w/2); the core never leaves the saved width; nothing links unconnected paths or invents curves.",
      "entranceEnds": "WF2 paths end in a butt cap at the protected entrance. The end joint extends about 0.4 units under the apron and building step; it is a flat decal in the terrain layer and never changes occupancy."
    },
    "woodland": {
      "strip": {
        "file": "woodland-fringe.png",
        "shape": "for every grass cell (dry, not flag 8/2) edge shared with a woodland cell (dry, flag 8 or 2): quad on the grass side spanning that unit edge and extending 0.6 units into the grass cell, heights from terrainReader.height",
        "u": "world coordinate along the edge / 4 (repeat)",
        "v": "0 at the shared edge, 1 at 0.6 units into the grass"
      },
      "purpose": "softens the cell-staircase boundary between the two ground materials; drawn right after the ground fill, before banks and paths",
      "missing": "no strip against missing (255) or water cells"
    },
    "shore": {
      "strip": {
        "file": "shore-strip.png",
        "shape": "for every land cell edge returned by coastEdges(x, y, read.cell): quad on the water plane (z 0.5) spanning that unit edge and extending 0.5 units into the water cell",
        "u": "world coordinate along the edge / 2 (repeat)",
        "v": "0 at the land edge, 1 at 0.5 units into the water"
      },
      "corner": {
        "file": "shore-corner.png",
        "shape": "for each water cell corner whose diagonal neighbour is land and whose two orthogonal neighbours sharing that corner are water: a 0.5 x 0.5 square in that corner on the water plane",
        "uv": "(0,0) at the land corner, axes pointing into the water cell"
      },
      "concave": "Where a water cell has land on two orthogonal sides the two strips overlap in the corner square; this is intended (a slightly brighter shallow).",
      "missing": "A neighbour with flags 255 is neither land nor water: emit no strip, corner or bank against it.",
      "drawOrder": "water fill, then bank faces, then shore strips and corners",
      "geometry": "Purely cosmetic overlays on the existing water plane: no bank height, collision, walkability or navigable land changes."
    }
  },
  "placement": {
    "hash": "h(x, y, salt) = (Math.imul(x, 73856093) ^ Math.imul(y, 19349663) ^ Math.imul(salt, 83492791)) >>> 0, with x, y the integer cell coordinates",
    "excluded": "Never place on: missing cells (255); any structure, project/construction site or claim footprint including its entrance apron; any path rectangle expanded by 0.25 units; outside the active terrain window.",
    "offsetInCell": "x + 0.2 + 0.6 * ((h >>> 12) & 255) / 255, y + 0.2 + 0.6 * ((h >>> 20) & 255) / 255",
    "lod": "Decorations only when the chunk is drawn at step 1 (close zoom). Ground patches at every step. Water glints only at step 1.",
    "dry": {
      "eligible": "flags != 255 && (flags & 7) == 0 (dry, not tree, not rock)",
      "salt": 1,
      "rules": [
        {
          "range": [
            0,
            7
          ],
          "items": [
            "tuft-a",
            "tuft-b",
            "tuft-c"
          ],
          "pick": "(h >>> 8) % 3"
